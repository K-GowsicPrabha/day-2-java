import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int seat = sc.nextInt();
        int mod = seat % 8;
        switch(mod) {
            case 1: case 4:
                System.out.println("LB");
                break;
            case 2: case 5:
                System.out.println("MB");
                break;
            case 3: case 6:
                System.out.println("UB");
                break;
            case 7:
                System.out.println("SL");
                break;
            case 0:
                System.out.println("SU");
                break;
        }
    }
}
