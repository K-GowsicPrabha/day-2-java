import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int a = sc.nextInt();
        int b = sc.nextInt();
        int c = sc.nextInt();
        int secondMax;
        if (a == b && b == c) {
            System.out.println("No second max");
        } 
        else {
            if ((a >= b && a <= c) || (a <= b && a >= c)) {
                secondMax = a;
            } else if ((b >= a && b <= c) || (b <= a && b >= c)) {
                secondMax = b;
            } else {
                secondMax = c;
            }
            System.out.println(secondMax);
        }
    }
}
